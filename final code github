                max_length = max((len(str(cell.value)) for cell in col if cell.value is not None))
                ws.column_dimensions[col[0].column_letter].width = min(max_length + 6, 60)
            except Exception:
                pass
        wb.save(outname)
        print("\nSaved summary:", outname)
        files.download(outname)

    # ==== Plots (accuracy & time across files) ====
    if plot_rows:
        dfp = pd.DataFrame(plot_rows)
        x = np.arange(len(dfp))
        names = [os.path.splitext(os.path.basename(f))[0] for f in dfp['file']]

        plt.figure(figsize=(12,5))
        plt.plot(x, dfp['tdup_acc'], marker='o', label='TDUP-Fuzzy')
        plt.plot(x, dfp['pso_acc'], marker='o', label='CRP-PSO')
        plt.plot(x, dfp['rbm_acc'], marker='o', label='RBM-GA')
        plt.plot(x, dfp['adaptive_acc'], marker='o', label='Adaptive KGAPSO-Fuzzy')
        plt.xticks(x, names, rotation=45, ha='right')
        plt.ylabel('Avg Accuracy (%)')
        plt.title('Method Accuracy comparison (per file)')
        plt.legend(); plt.tight_layout(); plt.show()

        plt.figure(figsize=(12,5))
        plt.plot(x, dfp['tdup_time'], marker='o', label='TDUP-Fuzzy')
        plt.plot(x, dfp['pso_time'], marker='o', label='CRP-PSO')
        plt.plot(x, dfp['rbm_time'], marker='o', label='RBM-GA')
        plt.plot(x, dfp['adaptive_time'], marker='o', label='Adaptive KGAPSO-Fuzzy')
        plt.xticks(x, names, rotation=45, ha='right')
        plt.ylabel('Avg Time (s)')
        plt.title('Method Time comparison (per file)')
        plt.legend(); plt.tight_layout(); plt.show()

    print("\nFinished processing all uploaded files.")
