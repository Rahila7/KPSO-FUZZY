N_ITER = 10  # number of experiment iterations
MIN_CLUSTER_FOR_SEARCH = 4   # if cluster size < this -> trivial ordering & time=0.0
USE_WEIGHTED_BENCHMARK = True  # benchmark = 0.7*TD + 0.3*UP (you asked)
BENCHMARK_WEIGHT_TD = 0.7
BENCHMARK_WEIGHT_UP = 0.3

# GA / PSO base seeds (you can increase for higher accuracy; careful with runtime)
GA_POP_BASE = 60
GA_GENS_BASE = 120
GA_MUTATION = 0.12
GA_CROSSOVER = 0.85

PSO_SWARM_BASE = 40
PSO_ITERS_BASE = 120

def size_adjusted_params(n):
    """Return tuned parameters (ga_pop, ga_gens, pso_swarm, pso_iters) based on cluster size."""
    if n <= 50:
        return GA_POP_BASE, GA_GENS_BASE, PSO_SWARM_BASE, PSO_ITERS_BASE
    if n <= 200:
        return max(20, GA_POP_BASE//2), max(30, GA_GENS_BASE//3), max(15, PSO_SWARM_BASE//2), max(30, PSO_ITERS_BASE//3)
    if n <= 600:
        return max(12, GA_POP_BASE//3), max(20, GA_GENS_BASE//4), max(8, PSO_SWARM_BASE//4), max(20, PSO_ITERS_BASE//6)
    # very large clusters: aggressive reduction to keep runtime reasonable
    return max(8, GA_POP_BASE//5), max(8, GA_GENS_BASE//10), max(6, PSO_SWARM_BASE//5), max(8, PSO_ITERS_BASE//12)

# ---------------------------
# Utilities
# ---------------------------
def norm(s): return str(s).strip().lower()

def find_best_cols(cols):
    cols_l = [norm(c) for c in cols]
    mapping = {}
    cand_sets = {
        'Requirement ID': ['requirement id','req id','req_id','reqid','id','requirement'],
        'Technical Dependency': ['technical dependency','td','tech dep','technical'],
        'User Preference': ['user preference','up','user pref','preference','userpreference']
    }
    for target, candidates in cand_sets.items():
        for cand in candidates:
            for i,c in enumerate(cols_l):
                if cand == c or cand in c or c in cand:
                    mapping[cols[i]] = target
                    break
            if target in mapping.values(): break
    return mapping

def calculate_disagreement_zip(list1, list2):
    """Simple position mismatch count (truncate list2 to length of list1)."""
    list2 = list2[:len(list1)]
    return sum(1 for a,b in zip(list1,list2) if a != b)

def kendall_like_distance(ordering, benchmark):
    """Kendall-style normalized discordant pair fraction (benchmark may be longer)."""
    ordering = list(ordering)
    n = len(ordering)
    if n < 2: return 0.0
    pos_b = {v:i for i,v in enumerate(benchmark)}
    discordant = 0
    total = 0
    # compare pairs in ordering and check consistency with benchmark
    for i in range(n):
        for j in range(i+1, n):
            a = ordering[i]; b = ordering[j]
            ia = pos_b.get(a, 0); ib = pos_b.get(b, 0)
            # if relative orders disagree, count discord
            if (i - j) * (ia - ib) < 0:
                discordant += 1
            total += 1
    return discordant / total if total > 0 else 0.0

# ---------------------------
# TDUP-Fuzzy ranking (real computation)
# ---------------------------
def trapezoidal_mf(x, a,b,c,d):
    if x <= a or x >= d: return 0.0
    if a < x < b: return (x-a)/(b-a)
    if b <= x <= c: return 1.0
    if c < x < d: return (d-x)/(d-c)
    return 0.0

def tdup_fuzzy_rank(df_cluster):
    t0 = time.perf_counter()
    mfs = {'Low':(0.0,0.0,0.2,0.4), 'Med':(0.3,0.45,0.55,0.7), 'High':(0.6,0.8,1.0,1.0)}
    centers = {'Low':0.15,'Med':0.5,'High':0.85}
    scores = []
    for _, row in df_cluster.iterrows():
        td = float(row['TD']); up = float(row['UP'])
        td_levels = {k: trapezoidal_mf(td,*v) for k,v in mfs.items()}
        up_levels = {k: trapezoidal_mf(up,*v) for k,v in mfs.items()}
        td_crisp = sum(td_levels[k]*centers[k] for k in centers) / (sum(td_levels.values()) + 1e-9)
        up_crisp = sum(up_levels[k]*centers[k] for k in centers) / (sum(up_levels.values()) + 1e-9)
        tdup = (td_crisp + up_crisp) / 2.0
        scores.append((row['Requirement ID'], tdup))
    scores.sort(key=lambda x: x[1], reverse=True)
    ordering = [s[0] for s in scores]
    elapsed = time.perf_counter() - t0
    return ordering, elapsed

# ---------------------------
# Robust GA (order GA) -> returns (ordering, discord_fraction, elapsed)
# ---------------------------
def order_crossover(p1, p2):
    n = len(p1)
    if n <= 1: return p1.copy()
    a,b = sorted(random.sample(range(n),2))
    child = [None]*n
    child[a:b+1] = p1[a:b+1]
    fill = [x for x in p2 if x not in child]
    idx = 0
    for i in range(n):
        if child[i] is None:
            if idx < len(fill):
                child[i] = fill[idx]; idx += 1
            else:
                for cand in p1 + p2:
                    if cand not in child:
                        child[i] = cand; break
                if child[i] is None:
                    child[i] = p1[0]
    return child

def replacement_biological_mutation(chrom, full_set):
    seen=set(); duplicates=[]
    for i,g in enumerate(chrom):
        if g in seen:
            duplicates.append(i)
        else:
            seen.add(g)
    missing=[x for x in full_set if x not in seen]
    for idx in duplicates:
        if missing:
            chrom[idx] = missing.pop(random.randrange(len(missing)))
    return chrom

def ga_rbm_rank(df_cluster, benchmark_ordering, pop_size=40, gens=80, crossover_rate=0.85, mute_rate=0.12, epsilon=0.0):
    t0 = time.perf_counter()
    items = df_cluster['Requirement ID'].tolist()
    n = len(items)
    if n == 0:
        return [], 0.0, 0.0
    if n < MIN_CLUSTER_FOR_SEARCH:
        order = items.copy()
        elapsed = 0.0
        discord = kendall_like_distance(order, benchmark_ordering)
        return order, discord, elapsed
    population = [random.sample(items, n) for _ in range(pop_size)]
    best = population[0]; best_d = kendall_like_distance(best, benchmark_ordering)
    for g in range(gens):
        for chrom in population:
            d = kendall_like_distance(chrom, benchmark_ordering)
            if d < best_d:
                best_d = d; best = chrom.copy()
        if best_d <= epsilon:
            break
        new_pop=[]
        while len(new_pop) < pop_size:
            a,b = random.sample(population,2)
            fa = 1 - kendall_like_distance(a, benchmark_ordering)
            fb = 1 - kendall_like_distance(b, benchmark_ordering)
            p1 = a if fa >= fb else b
            c,d_ = random.sample(population,2)
            fc = 1 - kendall_like_distance(c, benchmark_ordering)
            fd = 1 - kendall_like_distance(d_, benchmark_ordering)
            p2 = c if fc >= fd else d_
            child = order_crossover(p1,p2) if random.random() < crossover_rate else p1.copy()
            if random.random() < mute_rate:
                i,j = random.sample(range(n),2); child[i],child[j] = child[j],child[i]
            child = replacement_biological_mutation(child, items)
            new_pop.append(child)
        population = new_pop
    elapsed = time.perf_counter() - t0
    discord = kendall_like_distance(best, benchmark_ordering)
    return best, discord, elapsed

# ---------------------------
# CRP-PSO: permutation PSO -> returns (order, discord, elapsed)
# ---------------------------
def apply_swaps_toward(source, target, prob=0.35):
    src = source.copy()
    idx_map = {v:i for i,v in enumerate(src)}
    n = len(src)
    for i in range(n):
        if random.random() > prob: continue
        if src[i] != target[i]:
            j = idx_map.get(target[i], None)
            if j is None: continue
            src[i], src[j] = src[j], src[i]
            idx_map[src[j]] = j; idx_map[src[i]] = i
    return src

def pso_ordering(df_cluster, benchmark_ordering, swarm_size=30, iter_max=90, epsilon=0.0):
    t0 = time.perf_counter()
    items = df_cluster['Requirement ID'].tolist()
    n = len(items)
    if n == 0:
        return [], 0.0, 0.0
    if n < MIN_CLUSTER_FOR_SEARCH:
        order = items.copy(); elapsed = 0.0
        discord = kendall_like_distance(order, benchmark_ordering)
        return order, discord, elapsed
    swarm=[]; pbest=[]; pbest_score=[]
    for _ in range(swarm_size):
        perm = random.sample(items, n)
        swarm.append(perm)
        sc = 1 - kendall_like_distance(perm, benchmark_ordering)
        pbest.append(perm.copy()); pbest_score.append(sc)
    gbest_idx = int(np.argmax(pbest_score)); gbest = pbest[gbest_idx].copy(); gbest_score = pbest_score[gbest_idx]
    no_improve = 0; patience = 6
    for t in range(iter_max):
        for i in range(swarm_size):
            new = apply_swaps_toward(swarm[i], pbest[i], prob=0.45)
            new = apply_swaps_toward(new, gbest, prob=0.45)
            if random.random() < 0.12:
                a,b = random.sample(range(n),2); new[a],new[b] = new[b],new[a]
            swarm[i] = new
            sc = 1 - kendall_like_distance(new, benchmark_ordering)
            if sc > pbest_score[i]:
                pbest[i] = new.copy(); pbest_score[i] = sc
                if sc > gbest_score:
                    gbest = new.copy(); gbest_score = sc; no_improve = 0
        no_improve += 1
        if no_improve >= patience:
            patience += 2; no_improve = 0
        if 1 - gbest_score <= epsilon:
            break
    elapsed = time.perf_counter() - t0
    best_order = gbest
    discord = kendall_like_distance(best_order, benchmark_ordering)
    return best_order, discord, elapsed

# ---------------------------
# Adaptive K selection: TD banding + silhouette fallback (uses TD only per your request)
# ---------------------------
def adaptive_kmeans_selectK(df, feature_col='TD', use_UP=False, band_abs_thresh=0.05, gap_std_factor=1.0, kmax=8):
    X = df[[feature_col]].values if not use_UP else df[['TD','UP']].values
    n = X.shape[0]
    if n <= 1:
        return [df['Requirement ID'].tolist()], [df.reset_index(drop=True)]
    td_vals = np.array(df[feature_col])
    if np.var(td_vals) < 1e-9:
        return [df['Requirement ID'].tolist()], [df.reset_index(drop=True)]
    sorted_idx = np.argsort(td_vals)
    sorted_td = td_vals[sorted_idx]
    diffs = np.diff(sorted_td)
    mean_gap = float(np.mean(diffs)) if diffs.size>0 else 0.0
    std_gap = float(np.std(diffs)) if diffs.size>0 else 0.0
    dynamic_thresh = max(band_abs_thresh, mean_gap + gap_std_factor*std_gap)
    split_positions = [0]
    for i,d in enumerate(diffs):
        if d > dynamic_thresh:
            split_positions.append(i+1)
    split_positions.append(len(sorted_td))
    bands=[]
    for s,e in zip(split_positions[:-1], split_positions[1:]):
        band_idx = sorted_idx[s:e]
        band_ids = df.iloc[band_idx]['Requirement ID'].tolist()
        if band_ids:
            bands.append(band_ids)
    K_from_bands = len(bands)
    Kbound = max(1,int(math.floor(math.sqrt(n))))
    K_from_bands = min(K_from_bands, max(1,Kbound))
    chosen_K = K_from_bands if K_from_bands > 1 else None
    if chosen_K is None:
        Kmax_sil = max(2, min(Kbound, kmax))
        best_k = 1; best_score = -1.0
        for k in range(2, Kmax_sil+1):
            try:
                km = KMeans(n_clusters=k, random_state=42, n_init=10).fit(X)
                s = silhouette_score(X, km.labels_)
                if s > best_score:
                    best_score = s; best_k = k
            except Exception:
                continue
        chosen_K = best_k
    final_k = max(1, chosen_K)
    km = KMeans(n_clusters=final_k, random_state=42, n_init=10).fit(X)
    labels = km.labels_
    clusters=[]; cluster_dfs=[]
    for c in np.unique(labels):
        sub = df.iloc[np.where(labels==c)[0]].reset_index(drop=True)
        clusters.append(sub['Requirement ID'].tolist())
        cluster_dfs.append(sub.copy().reset_index(drop=True))
    return clusters, cluster_dfs

# ---------------------------
# run methods for cluster and return per-tech cluster accuracy (%) and time (s)
# ---------------------------
def run_cluster_methods(df_cluster, benchmark_ordering):
    results = {}
    n = len(df_cluster)
    if n == 0:
        return results
    # TDUP-Fuzzy
    order_fz, t_fz = tdup_fuzzy_rank(df_cluster)
    discord_fz = kendall_like_distance(order_fz, benchmark_ordering)
    acc_fz = 100 * (1 - discord_fz)
    results['TDUP-Fuzzy'] = {'order':order_fz, 'discord':discord_fz, 'acc':acc_fz, 'time': t_fz}
    # RBM-GA
    ga_pop, ga_gens, pso_swarm, pso_iters = size_adjusted_params(n)
    if n < MIN_CLUSTER_FOR_SEARCH:
        order_rbm = df_cluster['Requirement ID'].tolist(); t_rbm = 0.0
        discord_rbm = kendall_like_distance(order_rbm, benchmark_ordering)
    else:
        order_rbm, discord_rbm, t_rbm = ga_rbm_rank(df_cluster, benchmark_ordering, pop_size=ga_pop, gens=ga_gens, crossover_rate=GA_CROSSOVER, mute_rate=GA_MUTATION)
    acc_rbm = 100 * (1 - discord_rbm)
    results['RBM-GA'] = {'order':order_rbm, 'discord':discord_rbm, 'acc':acc_rbm, 'time': t_rbm}
    # CRP-PSO
    if n < MIN_CLUSTER_FOR_SEARCH:
        order_pso = df_cluster['Requirement ID'].tolist(); t_pso = 0.0
        discord_pso = kendall_like_distance(order_pso, benchmark_ordering)
    else:
        order_pso, discord_pso, t_pso = pso_ordering(df_cluster, benchmark_ordering, swarm_size=pso_swarm, iter_max=pso_iters)
    acc_pso = 100 * (1 - discord_pso)
    results['CRP-PSO'] = {'order':order_pso, 'discord':discord_pso, 'acc':acc_pso, 'time': t_pso}
    return results

